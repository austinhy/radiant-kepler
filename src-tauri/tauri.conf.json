{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radiant Kepler",
  "version": "1.0.0",
  "identifier": "com.radiantkepler.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Radiant Kepler — Crypto Market Intelligence & Good-Faith Predictions",
        "width": 1520,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
